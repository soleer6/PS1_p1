# Variables de entorno para LocalLibrary
# Práctica 1 PSI - 2025-26

# Clave secreta de Django (genera una nueva para producción)
DJANGO_SECRET_KEY=tu-clave-secreta-aqui

# Modo debug (True para desarrollo, False para producción)
DJANGO_DEBUG=True

# URL de PostgreSQL local (para desarrollo y tests)
POSTGRESQL_URL=postgres://alumnodb:alumnodb@localhost:5434/psi

# URL de Neon.tech (reemplaza con tu URL real)
NEON_URL=postgresql://usuario:password@host/neondb?sslmode=require

# Variable para elegir base de datos
# Si TESTING=1 -> usa POSTGRESQL_URL (local)
# Si TESTING no está definido -> usa NEON_URL (producción)
TESTING=1
